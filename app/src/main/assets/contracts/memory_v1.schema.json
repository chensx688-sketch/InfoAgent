{
  "$id": "memory_v1",
  "$comment": "记忆提炼输出契约（§8.5）。period 用于 P1 重复习惯识别。",
  "type": "object",
  "required": ["facts"],
  "properties": {
    "facts": {
      "type": "array", "maxItems": 10, "required": true,
      "items": {
        "type": "object", "required": ["category", "fact_text"],
        "properties": {
          "category": {"type": "string", "enum": ["HABIT", "PREFERENCE", "PATTERN", "RELATION"]},
          "subject": {"type": "string", "maxLength": 40},
          "fact_text": {"type": "string", "maxLength": 200},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "period": {"type": ["object", "null"], "properties": {
            "freq": {"type": "string", "enum": ["DAILY", "WEEKLY", "MONTHLY"]},
            "weekday": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
            "time": {"type": ["string", "null"], "maxLength": 10}
          }},
          "refs": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 40}}
        }
      }
    }
  }
}